# Copia in .env e compila. .env è ignorato da git.

# --- Database (obbligatorio) ---
DB_URL=postgres://postgres:postgres@localhost:5432/thoughts?sslmode=disable

# --- Server ---
PORT=8080

# --- Email (Resend) ---
# Senza RESEND_API_KEY le email non vengono inviate ma registrate sul log
# (modalità sviluppo), così l'app resta usabile in locale.
RESEND_API_KEY=
# Mittente verificato su Resend. Default: "thoughts <onboarding@resend.dev>"
EMAIL_FROM=thoughts <onboarding@resend.dev>
# URL base usato nei link delle email (reset password, ecc.).
APP_URL=http://localhost:8080
