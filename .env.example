# Copia in .env e compila. .env è ignorato da git.

# --- Database (obbligatorio) ---
DB_URL=postgres://postgres:postgres@localhost:5432/pensieri?sslmode=disable

# --- Server ---
PORT=8080

# --- Moderazione ---
# Email (separate da virgola) degli utenti amministratori. Gli admin possono
# eliminare liberamente qualsiasi pensiero o commento per moderare contenuti
# sensibili o vietati. L'elenco è l'unica fonte di verità: viene riapplicato a
# ogni avvio (chi non compare perde il ruolo). Lasciare vuoto per non avere admin.
ADMIN_EMAILS=

# --- Email (Resend) ---
# Senza RESEND_API_KEY le email non vengono inviate ma registrate sul log
# (modalità sviluppo), così l'app resta usabile in locale.
RESEND_API_KEY=
# Mittente verificato su Resend. Default: "pensieri <onboarding@resend.dev>"
EMAIL_FROM=pensieri <onboarding@resend.dev>
# URL base usato nei link delle email (reset password, ecc.) e per costruire
# il redirect URI di Google OAuth (APP_URL + /auth/google/callback).
APP_URL=http://localhost:8080

# --- Google OAuth (opzionale) ---
# Credenziali OAuth 2.0 dalla Google Cloud Console. Se una delle due è vuota,
# il pulsante "accedi/registrati con Google" non viene mostrato.
# Redirect URI autorizzato da impostare nella console: <APP_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
